{
  "name": "csasc",
  "description": "A web for CSASC",
  "version": "2.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "admin:build": "vite build --config admin/vite.config.ts",
    "admin:deploy": "pnpm admin:build && wrangler deploy --config admin-worker/wrangler.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply csasc-registrations --local",
    "db:migrate:remote": "wrangler d1 migrations apply csasc-registrations --remote",
    "docs:build": "vuepress-vite build src",
    "docs:clean-dev": "vuepress-vite dev src --clean-cache",
    "docs:dev": "vuepress-vite dev src",
    "docs:update-package": "pnpm dlx vp-update",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@vuepress/bundler-vite": "2.0.0-rc.18",
    "@vuepress/plugin-pwa": "2.0.0-rc.56",
    "@vitejs/plugin-vue": "5.1.4",
    "sass-embedded": "^1.79.5",
    "vite": "5.4.10",
    "vue": "^3.5.12",
    "vuepress": "2.0.0-rc.18",
    "vuepress-theme-hope": "2.0.0-rc.59",
    "wrangler": "4.127.1"
  },
  "packageManager": "pnpm@9.8.0+sha512.8e4c3550fb500e808dbc30bb0ce4dd1eb614e30b1c55245f211591ec2cdf9c611cabd34e1364b42f564bd54b3945ed0f49d61d1bbf2ec9bd74b866fcdc723276"
}
